# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dosti?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# SMS OTP (Twilio, or swap for a local Pakistani SMS gateway e.g. Telesign/Zong/Jazz APIs)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# File storage (profile photos)
AWS_REGION="me-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="dosti-uploads"
MAX_UPLOAD_MB=8
# Optional override for the local-disk upload fallback's URL — normally
# auto-derived from the incoming request (see services/uploads.js), so you
# only need this if you're serving uploads from a different domain than
# the API itself. Leave blank/unset in almost all cases.
SELF_BASE_URL=""

# Chat content moderation (hosted classifier endpoint, e.g. an OpenAI-style
# /moderations proxy or a Perspective API wrapper)
MODERATION_API_URL=""
MODERATION_API_KEY=""

# Redis (rate limiting; also usable later for caching / Socket.io scaling)
REDIS_URL="redis://localhost:6379"

# Optional: enables POST /dev/seed, an HTTP-triggerable version of `npm run
# seed` for hosts with no shell access (e.g. Render's free tier). Leave
# unset to disable the route entirely (it 404s if this isn't set). If you
# set it, generate a long random value — anyone with it can trigger seeding
# — and pass it back as the `X-Seed-Secret` header. See backend/README.md.
SEED_TRIGGER_SECRET=""
