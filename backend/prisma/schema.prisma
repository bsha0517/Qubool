// Dosti — Database Schema
// Run: npx prisma migrate deploy (see prisma/migrations)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Intention {
  DATING
  FRIENDSHIP
}

enum Gender {
  MALE
  FEMALE
}

enum GenderPreference {
  MALE
  FEMALE
  ANY
}

enum VerificationStatus {
  UNVERIFIED
  PHONE_VERIFIED
}

enum AdminRole {
  NONE
  MODERATOR
  SUPER_ADMIN
}

enum MatchStatus {
  PENDING   // one side liked, waiting on the other
  MATCHED   // mutual like
  PASSED    // one side passed
  UNMATCHED // a match was later broken
}

enum ReportReason {
  FAKE_PROFILE
  HARASSMENT
  INAPPROPRIATE_CONTENT
  SCAM_OR_SOLICITATION
  UNDERAGE
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
}

model User {
  id                  String              @id @default(uuid())
  phone               String?             @unique
  phoneVerified       Boolean             @default(false)
  email               String?             @unique
  emailVerified       Boolean             @default(false)
  passwordHash        String?
  verificationStatus  VerificationStatus  @default(UNVERIFIED)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lastActiveAt        DateTime            @default(now())
  isActive            Boolean             @default(true)
  isBanned            Boolean             @default(false)
  bannedReason         String?
  adminRole           AdminRole           @default(NONE)

  profile             Profile?

  sentLikes           MatchAction[]       @relation("ActionByUser")
  receivedLikes       MatchAction[]       @relation("ActionOnUser")

  matchesAsUserA      Match[]             @relation("UserA")
  matchesAsUserB      Match[]             @relation("UserB")

  messagesSent        Message[]           @relation("MessageSender")

  reportsFiled        Report[]            @relation("ReportedBy")
  reportsAgainst      Report[]            @relation("ReportedUser")

  otpCodes            OtpCode[]

  // Accounts can exist via phone+OTP, email+password, or (over time) both —
  // `phone` and `email` are each optional and each independently unique,
  // but at least one must be set (enforced in application code, not the DB,
  // since Prisma/Postgres don't have a clean native "at least one of" check).
  @@index([phone])
  @@index([email])
}

model Profile {
  id                String     @id @default(uuid())
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String     @unique

  name              String
  age               Int
  gender            Gender
  city              String
  intention         Intention
  education         String?
  profession        String?
  bio               String?    @db.VarChar(500)

  blurPhotosDefault Boolean    @default(true)

  // --- Discovery filters (apply one-directionally: they narrow what THIS
  // user sees, not who can see them) ---
  preferredGender   GenderPreference @default(ANY)
  ageMin            Int        @default(18)
  ageMax            Int        @default(60)
  sameCityOnly      Boolean    @default(false)

  photos            Photo[]
  prompts           ProfilePrompt[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([city])
  @@index([intention])
}

// Tinder-style conversation-starter prompts: a fixed question (from a
// small curated list enforced client-side + zod, not a DB enum, so new
// prompts can be added without a migration) plus the user's own answer.
// Capped at 3 per profile at the application layer.
model ProfilePrompt {
  id         String   @id @default(uuid())
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  question   String
  answer     String   @db.VarChar(300)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([profileId])
}

model Photo {
  id         String   @id @default(uuid())
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  url        String
  order      Int      @default(0)
  isPrimary  Boolean  @default(false)
  moderationStatus String @default("PENDING") // PENDING | PASSED | REJECTED
  moderationReason String?
  createdAt  DateTime @default(now())
}

// One row per swipe/decision. Two MatchAction rows (A->B, B->A) get
// reconciled into a Match when both are LIKE.
model MatchAction {
  id            String   @id @default(uuid())
  actor         User     @relation("ActionByUser", fields: [actorId], references: [id])
  actorId       String
  target        User     @relation("ActionOnUser", fields: [targetId], references: [id])
  targetId      String
  action        String   // "LIKE" | "PASS"
  createdAt     DateTime @default(now())

  @@unique([actorId, targetId])
  @@index([targetId])
}

model Match {
  id          String       @id @default(uuid())
  userA       User         @relation("UserA", fields: [userAId], references: [id])
  userAId     String
  userB       User         @relation("UserB", fields: [userBId], references: [id])
  userBId     String
  status      MatchStatus  @default(MATCHED)
  matchedAt   DateTime     @default(now())
  unmatchedAt DateTime?
  mediaUnlockedAt DateTime? // when photo/video sharing unlocks in chat

  messages    Message[]

  @@unique([userAId, userBId])
}

model Message {
  id          String   @id @default(uuid())
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId     String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  senderId    String
  body        String   @db.VarChar(2000)
  flaggedByAi Boolean  @default(false)
  createdAt   DateTime @default(now())
  readAt      DateTime?

  @@index([matchId, createdAt])
}

model Report {
  id           String        @id @default(uuid())
  reportedBy   User          @relation("ReportedBy", fields: [reportedById], references: [id])
  reportedById String
  reportedUser User          @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reportedUserId String
  reason       ReportReason
  details      String?       @db.VarChar(1000)
  status       ReportStatus  @default(OPEN)
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  moderatorNote String?

  @@index([status])
}

model OtpCode {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}
